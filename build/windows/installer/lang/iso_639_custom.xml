<?xml version="1.0" encoding="UTF-8" ?>

<!--
This file gives a list of some languages in the ISO 639
standard, and is used to generate lists to our .iss script
and to localize our .msix (AppxManifest and MS Store listing)

To fill data for a new entry:

1. dl_code is just the ISO code used as file name (i.e. the .po file's basename).
2. name is the localized name. On your system, lookup the English name in: share/xml/iso-codes/iso_639-2.xml
   Then run the following command:
   $ LANGUAGE=$DL_CODE gettext iso_639_3 "$ENGLISH_NAME"
   E.g. for Bengali, you would run:
   $ LANGUAGE=bn gettext iso_639_3 "Bengali"
3. For inno_code, check: https://github.com/jrsoftware/issrc/tree/main/Files/Languages/
4. Finally for ms_code, check (leave it empty if the language is not listed):
   https://learn.microsoft.com/windows/apps/publish/publish-your-app/msix/app-package-requirements#supported-languages
-->

<!DOCTYPE iso_639_entries [
	<!ELEMENT iso_639_entries (iso_639_entry+)>
	<!ELEMENT iso_639_entry EMPTY>
	<!ATTLIST iso_639_entry
		dl_code		CDATA	#REQUIRED
		inno_code	CDATA	#REQUIRED
		ms_code 	CDATA	#REQUIRED
		name			CDATA	#REQUIRED
	>
]>


#: plug-ins/python/palette-sort.py:90
msgid ""
"\n"
"    Format is 'start:nrows,length' . All items are optional.\n"
"\n"
"    The empty string selects all items, as does ':'\n"
"    ':4,' makes a 4-row selection out of all colors (length auto-"
"determined)\n"
"    ':4' also.\n"
"    ':1,4' selects the first 4 colors\n"
"    ':,4' selects rows of 4 colors (nrows auto-determined)\n"
"    ':3,4' selects 3 rows of 4 colors\n"
"    '4:' selects a single row of all colors after 4, inclusive.\n"
"    '3:,4' selects rows of 4 colors, starting at 3 (nrows auto-determined)\n"
"    '2:3,4' selects 3 rows of 4 colors (12 colors total), beginning at index "
"2.\n"
"    '4' is illegal (ambiguous)\n"
msgstr ""
"\n"
"    Format to „początek:n-wierszy,długość”. Wszystkie elementy są "
"opcjonalne.\n"
"\n"
"    Pusty ciąg wybiera wszystkie elementy oraz wykonuje „:”\n"
"    „:4,” zaznacza 4 wiersze z wszystkich kolorów (długość dobierana "
"automatycznie),\n"
"    a „:4” robi to samo.\n"
"    „:1,4” zaznacza 4 pierwsze kolory\n"
"    „:,4” wybiera wiersze 4 kolorów (n-wierszy dobierane automatycznie),\n"
"    „:3,4” wybiera 3 wiersze 4 kolorów\n"
"    „4:” zaznacza pojedyńczy wiersz wszystkich kolorów po 4, włącznie.\n"
"    „3:,4” zaznacza wiersze 4 kolorów, poczynając od 3 (n-wierszy dobierane "
"automatycznie)\n"
"    „2:3,4” wybiera 3 wiersze 4 kolorów (łącznie 12 kolorów), poczynając od "
"indeksu 2.\n"
"    „4” jest niedozwolone (dwuznaczne)\n"

